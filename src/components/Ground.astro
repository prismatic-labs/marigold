---
import { geoArea, geoMercator, geoPath } from "d3-geo";
import type { Feature, FeatureCollection, Geometry, MultiPolygon, Polygon } from "geojson";
import { districts, flow, minerals, mineralsReaching, pathOf, sourceById } from "../lib/data";
import { t } from "../lib/copy";
import shapes from "../../data/districts-2021.geojson?raw";

const DEFAULT = "iron-ore";

// District polygons, drawn once at build time so the page needs no map library.
const geo = JSON.parse(shapes) as FeatureCollection<Geometry, { shapeName: string }>;
// d3 reads a ring wound the wrong way as "the whole globe except this", which draws a filled box.
for (const feature of geo.features) {
  if (geoArea(feature) > 2 * Math.PI) {
    const g = feature.geometry as Polygon | MultiPolygon;
    if (g.type === "Polygon") g.coordinates.forEach((ring) => ring.reverse());
    else g.coordinates.forEach((poly) => poly.forEach((ring) => ring.reverse()));
  }
}
const WIDTH = 420;
const HEIGHT = 560;
const projection = geoMercator().fitSize([WIDTH, HEIGHT], geo);
const path = geoPath(projection).digits(1);
const idOf = (shape: string) =>
  districts.list.find((d) => d.shape === shape || d.name === shape)?.id ?? shape.toLowerCase().replace(/[^a-z0-9]+/g, "-");
const nameOfDistrict = (id: string) => districts.list.find((d) => d.id === id)?.name ?? id;
const polygons = geo.features.map((f: Feature<Geometry, { shapeName: string }>) => {
  const id = idOf(f.properties.shapeName);
  return {
    id,
    d: path(f)!,
    minerals: minerals.list.filter((m) => m.districts.includes(id)).map((m) => m.id),
    name: nameOfDistrict(id),
  };
});

// Flow map: three columns laid out in rows; lines drawn in a 0-100 x space so labels can reflow.
const reach = mineralsReaching();
const ROW = 46;
const rows = flow.materials.length;
const place = (count: number, i: number) => (rows * ROW * (i + 0.5)) / count;
const nodes = new Map<string, { y: number; col: number }>();
minerals.list.forEach((m, i) => nodes.set(m.id, { y: place(minerals.list.length, i), col: 0 }));
flow.materials.forEach((m, i) => nodes.set(m.id, { y: place(rows, i), col: 1 }));
flow.uses.forEach((m, i) => nodes.set(m.id, { y: place(flow.uses.length, i), col: 2 }));
const X = { from: [21, 54], to: [33, 66] };
const edges = flow.edges.map((e) => {
  const a = nodes.get(e.from)!;
  const b = nodes.get(e.to)!;
  const x0 = X.from[a.col];
  const x1 = X.to[a.col];
  const mid = (x0 + x1) / 2;
  return { ...e, d: `M${x0},${a.y} C${mid},${a.y} ${mid},${b.y} ${x1},${b.y}`, ms: (reach.get(e.from) ?? []).join(" ") };
});
const labelOf = (id: string) =>
  minerals.list.find((m) => m.id === id)?.name ??
  flow.materials.find((m) => m.id === id)?.label ??
  flow.uses.find((m) => m.id === id)!.label;
---

<section aria-labelledby="ground-title" class="ground" data-mineral={DEFAULT}>
  <h2 id="ground-title">{t.groundTitle}</h2>
  <p class="sub">{t.groundSub}</p>

  <div class="tiles" role="group" aria-label={t.groundTitle}>
    {
      minerals.list.map((m) => (
        <button type="button" class="tile" aria-pressed={m.id === DEFAULT ? "true" : "false"} data-pick={m.id} style={`--accent:${m.accent}`}>
          <span class:list={["sym", m.symbol.length > 6 && "long"]}>{m.symbol}</span>
          <strong>{m.name}</strong>
          <small>{m.kind}</small>
        </button>
      ))
    }
  </div>
  {minerals.list.map((m) => <p class="list-note" data-m={m.id} hidden={m.id !== DEFAULT}>{t.mineralNotes[m.id as keyof typeof t.mineralNotes]}</p>)}

  <div class="pair">
    <div class="map-side">
      <h3>{t.mapTitle}</h3>
      <svg class="map" viewBox={`0 0 ${WIDTH} ${HEIGHT}`} role="img" aria-label={t.mapTitle}>
        {
          polygons.map((p) => (
            <path d={p.d} data-ms={p.minerals.join(" ")} class:list={[p.minerals.includes(DEFAULT) && "lit"]}>
              <title>{p.name}</title>
            </path>
          ))
        }
      </svg>
      {minerals.list.map((m) => <p class="named" data-m={m.id} hidden={m.id !== DEFAULT}>{m.districts.map(nameOfDistrict).join(", ")}</p>)}
      <p class="cite">{t.mapNote} <a href={sourceById("ibm-state-2022").url}>Indian Bureau of Mines, 2022</a> · <a href={sourceById("geoboundaries").url}>geoBoundaries 2021, ODbL</a></p>
    </div>

    <div class="flow-side">
      <h3>{t.flowTitle}</h3>
      <p class="cite">{t.flowNote}</p>
      <div class="heads">
        <span class="col0">{t.flowHeads.mineral}</span>
        <span class="col1">{t.flowHeads.material}</span>
        <span class="col2">{t.flowHeads.use}</span>
      </div>
      <div class="flow" style={`height:${rows * ROW}px`}>
        <svg viewBox={`0 0 100 ${rows * ROW}`} preserveAspectRatio="none" aria-hidden="true">
          {edges.map((e) => <path d={e.d} data-ms={e.ms} class:list={[e.ms.split(" ").includes(DEFAULT) && "lit"]} vector-effect="non-scaling-stroke" />)}
        </svg>
        {
          minerals.list.map((m) => (
            <button type="button" class:list={["node col0", m.id === DEFAULT && "lit"]} data-pick={m.id} data-ms={m.id} style={`top:${nodes.get(m.id)!.y}px`}>{m.name}</button>
          ))
        }
        {
          flow.materials.map((m) => (
            <span class:list={["node col1", (reach.get(m.id) ?? []).includes(DEFAULT) && "lit"]} data-ms={(reach.get(m.id) ?? []).join(" ")} style={`top:${nodes.get(m.id)!.y}px`}>
              {m.inState && <i class="dot" title={t.inState}></i>}{m.label}
            </span>
          ))
        }
        {
          flow.uses.map((m) => (
            <span class:list={["node col2", (reach.get(m.id) ?? []).includes(DEFAULT) && "lit"]} data-ms={(reach.get(m.id) ?? []).join(" ")} style={`top:${nodes.get(m.id)!.y}px`}>{m.label}</span>
          ))
        }
      </div>
      <p class="cite key"><i class="dot"></i> {t.inState}</p>
    </div>
  </div>

  <h3 class="links-title">{t.linksTitle}</h3>
  {
    minerals.list.map((m) => (
      <ul class="chain" data-m={m.id} hidden={m.id !== DEFAULT}>
        {pathOf(m.id).map((e) => (
          <li>
            <b>{labelOf(e.from)} → {labelOf(e.to)}</b>
            <span>{e.text} <a class="cite" href={sourceById(e.source).url}>{sourceById(e.source).org}</a></span>
          </li>
        ))}
      </ul>
    ))
  }
</section>

<script>
  document.querySelectorAll<HTMLElement>(".ground").forEach((root) => {
    const show = (id: string) => {
      root.dataset.mineral = id;
      root.querySelectorAll<HTMLElement>(".tile").forEach((tile) => tile.setAttribute("aria-pressed", String(tile.dataset.pick === id)));
      root.querySelectorAll<HTMLElement>(".list-note, .named, .chain").forEach((el) => (el.hidden = el.dataset.m !== id));
      root.querySelectorAll<Element>("[data-ms]").forEach((el) => {
        el.classList.toggle("lit", (el.getAttribute("data-ms") ?? "").split(" ").includes(id));
      });
    };
    root.querySelectorAll<HTMLElement>("[data-pick]").forEach((b) => b.addEventListener("click", () => show(b.dataset.pick!)));
  });
</script>

<style>
  .tiles { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 0.5rem; margin-top: 1rem; }
  .tile {
    display: flex; flex-direction: column; align-items: flex-start; gap: 0.1rem;
    min-width: 0; padding: 0.7rem;
    border: 1.5px solid var(--line); border-radius: 6px; background: #fbfaf7; text-align: left; cursor: pointer;
  }
  .tile:hover { border-color: var(--ink); }
  .tile[aria-pressed="true"] { border-color: var(--ink); background: var(--ink); color: var(--paper); }
  .sym { font-size: 1.35rem; font-weight: 400; line-height: 1.2; color: var(--accent); }
  .sym.long { font-size: 0.85rem; line-height: 2; white-space: nowrap; }
  .tile[aria-pressed="true"] .sym { color: var(--marigold); }
  .tile strong { font-weight: 800; line-height: 1.2; margin-top: 0.3rem; }
  .tile small { color: var(--muted); font-size: 0.75rem; line-height: 1.2; }
  .tile[aria-pressed="true"] small { color: #d8d4c8; }
  .list-note { margin-top: 0.75rem; max-width: 46rem; font-weight: 600; }
  [hidden] { display: none !important; }

  .pair { display: grid; grid-template-columns: minmax(0, 19rem) minmax(0, 1fr); gap: 2rem 2.5rem; margin-top: 2rem; align-items: start; }
  .map { display: block; width: 100%; margin-top: 0.5rem; }
  .map path { fill: #e6e2d8; stroke: var(--paper); stroke-width: 1; transition: fill 0.12s; }
  .map path:hover { fill: #cfc9ba; }
  .map path.lit { fill: var(--marigold); }
  .map path.lit:hover { fill: #c76d00; }
  .named { margin-top: 0.5rem; font-size: 0.9rem; font-weight: 600; line-height: 1.35; }
  .map-side .cite { display: block; margin-top: 0.4rem; font-size: 0.78rem; line-height: 1.35; }

  .flow-side > .cite { display: block; margin-top: 0.1rem; }
  .heads { position: relative; height: 1.7rem; margin-top: 0.75rem; border-bottom: 1.5px solid var(--ink); color: var(--ink); font-size: 0.8rem; font-weight: 800; }
  .heads span { position: absolute; bottom: 0.25rem; padding-inline: 0.4rem; }
  .flow { position: relative; margin-top: 0.4rem; }
  .flow svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .flow path { fill: none; stroke: #ddd8cd; stroke-width: 1.25; transition: stroke 0.15s; }
  .flow path.lit { stroke: var(--marigold); stroke-width: 2.5; }
  .node {
    position: absolute; transform: translateY(-50%);
    display: block; padding: 0.1rem 0.4rem; font-size: clamp(0.72rem, 1.9vw, 0.9rem); line-height: 1.15;
    color: #6b675f; transition: color 0.15s; background: var(--paper);
  }
  .node.lit { color: var(--ink); font-weight: 800; }
  .col0 { left: 0; width: 21%; text-align: right; }
  button.col0 { border: 0; cursor: pointer; }
  button.col0:hover { color: var(--ink); text-decoration: underline; text-decoration-color: var(--marigold); }
  .col1 { left: 33%; width: 21%; }
  .col2 { left: 66%; width: 34%; }
  .dot { display: inline-block; width: 0.55em; height: 0.55em; margin-right: 0.3em; border-radius: 50%; background: var(--marigold); vertical-align: 0.05em; }
  .key { display: block; margin-top: 0.75rem; }

  .links-title { margin-top: 2rem; }
  .chain { display: grid; grid-template-columns: repeat(auto-fit, minmax(19rem, 1fr)); gap: 0.75rem 2rem; margin: 0.6rem 0 0; padding: 0; list-style: none; }
  .chain li { font-size: 0.95rem; line-height: 1.4; }
  .chain b { display: block; font-weight: 800; }

  @media (max-width: 52rem) {
    .tiles { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .pair { grid-template-columns: minmax(0, 1fr); }
    .map-side svg { max-width: 22rem; }
  }
</style>
